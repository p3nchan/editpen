{
  "name": "editpen",
  "version": "0.1.0",
  "description": "Evidence-backed Chinese writing linter",
  "license": "MIT AND CC-BY-4.0",
  "author": "小企鵝 Penchan (https://penchan.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p3nchan/editpen.git"
  },
  "homepage": "https://penchan.co/editpen/",
  "bugs": {
    "url": "https://github.com/p3nchan/editpen/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "bin": {
    "editpen": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "research/README.md",
    "research/ledger.md",
    "research/practitioner-survey.md",
    "LICENSE-RESEARCH",
    "research/sweep-2026-09.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile-data": "tsx scripts/compile-browser-data.ts",
    "build": "npm run compile-data && tsc && tsx scripts/bundle-browser.ts",
    "typecheck": "npm run compile-data && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "check-rules": "tsx src/cli.ts check-rules",
    "check-parity": "tsx scripts/check-parity.ts",
    "test": "npm run check-engine && npm run check-parity && npm run check-perf && npm run check-rules && npm run check-skill",
    "pretest": "npm run build && tsc --noEmit -p tsconfig.scripts.json",
    "check-engine": "tsx scripts/check-engine.ts",
    "check-perf": "tsx scripts/check-perf.ts",
    "sync-skill": "tsx scripts/sync-skill-manifests.ts",
    "check-skill": "tsx scripts/sync-skill-manifests.ts --check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
