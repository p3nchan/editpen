{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://editpen.dev/schema/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "include", "candidate_ceiling"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "extends": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["core", "core-candidate", "zh-tw", "experimental", "house"] }
        }
      }
    },
    "candidate_ceiling": { "enum": ["error", "warn", "info", "off"] },
    "lexicons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "compose": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "enable": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][0-9]{2}[a-z]$" }
    },
    "frontmatter_prose": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" }
    },
    "severity": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][0-9]{2}[a-z]$" },
      "additionalProperties": { "enum": ["error", "warn", "info", "off"] }
    }
  }
}
